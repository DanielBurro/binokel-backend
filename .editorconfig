# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Bei Markdown-Dateien bedeuten zwei Leerzeichen am Zeilenende einen Zeilenumbruch
[*.md]
trim_trailing_whitespace = false

# Makefiles benötigen zwingend echte Tabs
[Makefile]
indent_style = tab