                  "minLength": 1,
                  "maxLength": 32
                }
              }
            },
            "required": [
              "type",
              "cardIds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "declare"
              },
              "trump": {
                "type": "string",
                "enum": [
                  "eichel",
                  "gruen",
                  "herz",
                  "schellen"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "play",
                  "abgehen"
                ]
              }
            },
            "required": [
              "type",
              "trump",
              "mode"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "submitMelds"
              },
              "meldIds": {
                "maxItems": 48,
