{
  "clientEvents": {
    "room:create": {
      "payload": "CreateRoomPayload",
      "ack": "RoomJoinedAck"
    },
    "room:join": {
      "payload": "JoinRoomPayload",
      "ack": "RoomJoinedAck"
    },
    "room:leave": {
      "payload": "LeaveRoomPayload",
      "ack": "LeaveRoomAck"
    },
    "session:resume": {
      "payload": "ResumeSessionPayload",
      "ack": "SessionResumedAck"
    },
    "game:intent": {
      "payload": "IntentPayload",
      "ack": "IntentAck"
    }
  },
  "serverEvents": {
    "room:state": {
      "payload": "RoomView"
    },
    "game:state": {
      "payload": "PlayerView"
    },
    "game:events": {
      "payload": "GameEvents"
    }
  },
  "clientSchemas": {
    "schemas": {
      "SpecialRules": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "halbeStrafe": {
            "default": false,
            "type": "boolean"
          },
          "trumpfStichzwang": {
            "default": false,
            "type": "boolean"
          },
          "durch": {
            "default": false,
            "type": "boolean"
          },
          "untendurch": {
            "default": false,
            "type": "boolean"
          },
          "rufen": {
            "default": false,
            "type": "boolean"
          },
          "keinDabb": {
            "default": false,
            "type": "boolean"
          },
          "tauschen": {
            "default": false,
            "type": "boolean"
          }
        },
        "additionalProperties": false
